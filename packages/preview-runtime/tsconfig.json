{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "skipLibCheck": true
  },
  "include": ["src"],
  // P3-3: tests run through vitest from the workspace root; they must not
  // land in the published dist type surface.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
