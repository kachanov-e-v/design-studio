{
  "name": "design-studio",
  "displayName": "Дизайн-студия",
  "description": "Минималистичный визуальный редактор компонентов Next.js с экспортом инструкций для ИИ",
  "version": "0.0.1",
  "publisher": "kachanov-e-v",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kachanov-e-v/design-studio.git"
  },
  "keywords": [
    "vscode",
    "design",
    "nextjs",
    "css",
    "visual editor",
    "design studio"
  ],
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "design-studio.open",
        "title": "Открыть дизайн-студию",
        "category": "Дизайн-студия"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:runtime && npm run copy:runtime && npm run build:webview && npm run inline:demo && npm run verify:build",
    "build:ext": "esbuild ./src/extension/extension.ts --bundle --platform=node --outfile=./dist/extension.js --external:vscode --format=cjs --sourcemap",
    "build:runtime": "npm --prefix packages/preview-runtime run build",
    "copy:runtime": "node scripts/copy-runtime.js",
    "build:webview": "vite build",
    "inline:demo": "node scripts/inline-demo-runtime.js",
    "verify:build": "node scripts/verify-build.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src webview packages/preview-runtime/src scripts",
    "test": "vitest run",
    "dev:webview": "vite"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.105.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.73.0"
  }
}
